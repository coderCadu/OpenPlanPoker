  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "test:backend": "jest src/backend --testPathIgnorePatterns='integration'",
    "test:frontend": "vitest --run src/frontend",
    "test:unit": "jest src/backend --testPathIgnorePatterns='integration' && vitest --run src/frontend",
    "test:integration": "jest --testPathPattern='integration.*\\.spec\\.ts$'",
    "test": "npm run test:unit && npm run test:integration",
    "dev": "ts-node -P tsconfig.backend.json src/backend/server.ts",
    "dev:frontend": "vite",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
