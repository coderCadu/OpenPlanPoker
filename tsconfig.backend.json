{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2020"]
  },
  "include": ["src/backend/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/__tests__/**", "src/frontend/**/*"]
}
