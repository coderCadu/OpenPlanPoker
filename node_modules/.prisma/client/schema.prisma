// Planning Poker - Data Model
// https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Session: Main container for a planning poker session
model Session {
  id             String        @id @default(cuid())
  slug           String        @unique @db.VarChar(255) // Unique URL-friendly identifier
  name           String        @db.VarChar(255)
  description    String?       @db.Text
  status         SessionStatus @default(ACTIVE) // ACTIVE, CLOSED, ARCHIVED
  moderatorId    String        @db.VarChar(255) // Pseudonym of moderator
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastActivityAt DateTime      @default(now()) // Updated on any participant activity
  expiresAt      DateTime? // Set when session becomes archived

  // Relations
  participants Participant[]
  epics        Epic[]
  stories      Story[]
  tasks        Task[]
  votes        Vote[]
  messages     Message[]

  // Indexes for efficient queries
  @@index([slug])
  @@index([lastActivityAt])
  @@index([createdAt])
  @@index([status])
}

// Participant: Individual in a session
model Participant {
  id             String   @id @default(cuid())
  sessionId      String
  pseudonym      String   @db.VarChar(50)
  joinedAt       DateTime @default(now())
  lastActivityAt DateTime @default(now())

  // Relations
  session  Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  votes    Vote[]
  messages Message[]

  // Constraints
  @@unique([sessionId, pseudonym]) // No duplicate names within session
  @@index([sessionId])
}

// Epic: Top-level organizational unit
model Epic {
  id             String   @id @default(cuid())
  sessionId      String
  title          String   @db.VarChar(255)
  description    String?  @db.Text
  estimatePoints Int? // Final consensus estimate
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stories Story[]

  // Indexes
  @@index([sessionId])
  @@index([createdAt])
}

// Story: User story within an epic
model Story {
  id             String   @id @default(cuid())
  sessionId      String
  epicId         String
  title          String   @db.VarChar(255)
  description    String?  @db.Text
  estimatePoints Int? // Final consensus estimate
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  epic    Epic    @relation(fields: [epicId], references: [id], onDelete: Cascade)
  tasks   Task[]

  // Indexes
  @@index([sessionId])
  @@index([epicId])
  @@index([createdAt])
}

// Task: Atomic unit of work within a story
model Task {
  id              String     @id @default(cuid())
  sessionId       String
  storyId         String
  title           String     @db.VarChar(255)
  description     String?    @db.Text
  estimatePoints  Int? // Final consensus estimate
  status          TaskStatus @default(UNESTIMATED) // UNESTIMATED, VOTING, REVEALED, ESTIMATED
  revealedAverage Float? // Average of votes when revealed
  revealedMedian  Float? // Median of votes when revealed
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  story   Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  votes   Vote[]

  // Indexes
  @@index([sessionId])
  @@index([storyId])
  @@index([status])
  @@index([createdAt])
}

// Vote: Individual participant vote on a task
model Vote {
  id            String   @id @default(cuid())
  taskId        String
  participantId String
  sessionId     String
  card          String   @db.VarChar(10) // "1", "2", "3", "5", "8", "13", "21", "?", "coffee"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Constraints: Each participant votes only once per task
  @@unique([taskId, participantId])
  @@index([sessionId])
  @@index([taskId])
  @@index([participantId])
  @@index([createdAt])
}

// Message: Chat message in a session
model Message {
  id            String   @id @default(cuid())
  sessionId     String
  participantId String
  content       String   @db.VarChar(500) // Truncated to 500 chars
  createdAt     DateTime @default(now())

  // Relations
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([sessionId])
  @@index([participantId])
  @@index([createdAt])
}

// Enums
enum SessionStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum TaskStatus {
  UNESTIMATED
  VOTING
  REVEALED
  ESTIMATED
}
